  "mechanisms": [
    {
      "name": "PPARalpha activation",
      "description": "PFAS activate PPARalpha receptor in liver, causing lipid metabolism disorders and hepatomegaly.",
      "source": "Sunderland et al., 2019"
    },
    {
      "name": "Oxidative stress",
      "description": "PFAS generate reactive oxygen species, causing DNA and protein damage.",
      "source": "Fenton et al., 2021"
    },
    {
      "name": "Thyroid disruption",
      "description": "PFAS compete with thyroid hormone for transport protein binding.",
      "source": "Post et al., 2017"
    },
    {
      "name": "Immunosuppression",
      "description": "PFAS suppress B lymphocyte differentiation and antibody production.",
      "source": "Grandjean et al., 2012"
    },
    {
      "name": "Mitochondrial dysfunction",
      "description": "PFAS interfere with electron transport chain in mitochondria.",
      "source": "Sheng et al., 2022"
    },
    {
      "name": "Endocrine disruption",
      "description": "PFAS interfere with estrogen, androgen, and thyroid hormone signaling.",
      "source": "ATSDR, 2021"
    }
  ],
  "regulations": [
    {
